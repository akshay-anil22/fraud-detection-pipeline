# Airflow metadata + app database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=fraud_db
POSTGRES_PORT=5432

# Airflow
AIRFLOW_UID=50000
AIRFLOW_VERSION=2.10.0

# Data source (for local dev outside container)
DATA_DIR=./data

# Force a fresh download from the Kaggle API on every run (set to 1 to enable)
# Useful if the remote dataset changes. Default: 0 (reuse cached CSV).
FORCE_REFRESH=0

# Kaggle API token (for auto-fetching the dataset) - get from https://www.kaggle.com/settings
KAGGLE_API_TOKEN=your_kaggle_api_token_here
